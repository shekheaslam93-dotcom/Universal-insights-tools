generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          String    @default("user") // user, admin
  primaryColor  String    @default("#3b82f6") // User's custom theme color
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  accounts      Account[]
  sessions      Session[]
  usageHistory  UsageHistory[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Tool {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  category    String   // AI Video, AI Image, Writing, TTS, Tools, Learning
  icon        String?
  embedUrl    String?  // For iframe embeds
  componentType String? // For client-side components: prompt-writer, image-upscaler, tts, etc.
  isActive    Boolean  @default(true)
  isFeatured  Boolean  @default(false)
  tags        String?  // JSON array of tags
  metaTitle   String?
  metaDescription String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  usageHistory UsageHistory[]
}

model UsageHistory {
  id        String   @id @default(cuid())
  userId    String
  toolId    String
  createdAt DateTime @default(now())
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tool Tool @relation(fields: [toolId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([toolId])
}

model Analytics {
  id        String   @id @default(cuid())
  event     String   // page_view, tool_open, download, etc.
  data      String?  // JSON data
  createdAt DateTime @default(now())
  
  @@index([event])
  @@index([createdAt])
}
